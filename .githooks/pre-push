#!/bin/sh
# The same gate CI runs, and it takes seconds: typecheck, lint, and pnpm test
# (node --test against PostgreSQL in process, no browser, no external
# service). Nothing here needs a database of its own.
#
# The refs git feeds on stdin are deliberately ignored: skipping per branch is
# what --no-verify is for.
set -e
echo "pre-push: typecheck + lint + test (git push --no-verify skips this)"
pnpm typecheck
pnpm lint
pnpm test
