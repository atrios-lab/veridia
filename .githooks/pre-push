#!/bin/sh
# Fast checks only. The e2e suite runs twice otherwise: once here, blocking
# the push, and again in CI right after — same 9+ minutes paid twice for
# every push. CI is the gate for e2e; this hook is just the quick local net.
#
# The refs git feeds on stdin are deliberately ignored: skipping per branch is
# what --no-verify is for.
set -e
echo "pre-push: typecheck + lint + test (git push --no-verify skips this)"
pnpm typecheck
pnpm lint
pnpm test
