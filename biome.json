{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!.claude/worktrees"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next": "src/core is pure domain: no framework, no I/O.",
                  "react": "src/core is pure domain: no framework, no I/O.",
                  "react-dom": "src/core is pure domain: no framework, no I/O.",
                  "drizzle-orm": "src/core is pure domain: no database client.",
                  "better-auth": "src/core is pure domain: no auth library.",
                  "node:fs": "src/core is pure domain: no I/O."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/(public)/**", "src/app/_components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/admin/_ui/**", "**/admin/_ui/**"],
                    "message": "src/app/admin/_ui is the panel's component kit; the public site draws with its own brand classes (painel-neutro-shadcn)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
