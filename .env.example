# Copie para .env.local e preencha com os valores reais.
# Este arquivo e versionado: nunca coloque segredo de verdade aqui.

# PostgreSQL na Supabase, via pooler Supavisor (modo transaction, porta 6543).
# Usada em runtime pela aplicacao.
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Conexao direta a Supabase (porta 5432), sem pooler. Usada so por
# drizzle-kit (db:generate/db:migrate), que precisa de DDL sem restricao
# de pooler em modo transaction.
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres"

# Serventia servida quando o host da requisicao nao esta mapeado.
DEFAULT_TENANT="cartorio-marinho"

# Better Auth. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# Usuario administrador criado pelo seed. Nao existe cadastro publico.
# Todo usuario pertence a uma serventia so: para criar administrador de outra,
# rode o seed de novo com outro ADMIN_SEED_TENANT.
ADMIN_SEED_EMAIL="admin@exemplo.com"
ADMIN_SEED_PASSWORD="troque-por-uma-senha-forte"
ADMIN_SEED_TENANT="cartorio-marinho"

# Conta da plataforma Atrios (pnpm db:seed-superadmin): entra em qualquer
# serventia registrada, ao contrario do seed acima. Opcional em dev.
SUPERADMIN_SEED_EMAIL="superadmin@atrios.app"
SUPERADMIN_SEED_PASSWORD="troque-por-uma-senha-forte"

# Rate limit (Upstash Redis). Sem estas duas, o limite fica desligado em dev.
UPSTASH_REDIS_REST_URL="https://exemplo.upstash.io"
UPSTASH_REDIS_REST_TOKEN="token-de-exemplo"

# Vercel Blob, para anexos do cidadao e para as imagens de marca enviadas
# pelo painel (aba Identidade Visual). BLOB_PUBLIC_HOST e so o hostname da
# URL publica do seu Blob Store (ex.: "abc123xyz.public.blob.vercel-storage.com"),
# liberado no CSP e no next/image como host exato — nunca curinga.
BLOB_READ_WRITE_TOKEN=""
BLOB_PUBLIC_HOST=""

# E-mail transacional (convite de primeiro acesso, nova senha), via Resend.
# Sem RESEND_API_KEY, o envio vira log local — dev e CI seguem funcionais.
# EMAIL_FROM_ADDRESS e um unico endereco tecnico da plataforma, verificado
# no provedor; o nome de exibicao de cada e-mail e o da propria serventia.
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="nao-responda@notificacoes.veridia.app"
