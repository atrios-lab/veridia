# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/

# anexos gravados em disco no desenvolvimento (UPLOAD_DIR)
/var/

# imagens de marca gravadas em disco no desenvolvimento (sem BLOB_READ_WRITE_TOKEN)
/public/uploads/

.playwright-mcp
temp
# estado do loop de qualidade de front-end
.claude/loop-state.md
